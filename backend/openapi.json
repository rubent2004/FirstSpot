{
  "openapi": "3.1.0",
  "info": {
    "title": "Geo-Prioridad Vulnerable API",
    "description": "Geospatial prioritization platform for humanitarian response, civil protection, and healthcare institutions.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Get API service health status",
        "description": "Return operational status of the backend service.",
        "operationId": "getHealthStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/zones": {
      "get": {
        "tags": [
          "places"
        ],
        "summary": "List predefined geographic zones in El Salvador",
        "description": "Return all configured El Salvador zones with center coordinates and default radius.",
        "operationId": "listPredefinedZones",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PredefinedZoneRead"
                  },
                  "type": "array",
                  "title": "Response Listpredefinedzones"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/places/sync": {
      "post": {
        "tags": [
          "places"
        ],
        "summary": "Synchronize vulnerable places from OpenStreetMap Overpass API",
        "description": "Query Overpass API and idempotently upsert vulnerable places into PostGIS.",
        "operationId": "syncPlacesFromOverpass",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncZoneRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPlacesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/places": {
      "get": {
        "tags": [
          "places"
        ],
        "summary": "List prioritized vulnerable places ordered by priority_score DESC",
        "description": "Return vulnerable places filtered by attributes or spatial radius and ordered by priority_score DESC.",
        "operationId": "listPrioritizedPlaces",
        "parameters": [
          {
            "name": "zone_name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by zone name",
              "title": "Zone Name"
            },
            "description": "Filter by zone name"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/PlaceCategory"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by OSM place category",
              "title": "Category"
            },
            "description": "Filter by OSM place category"
          },
          {
            "name": "vulnerability_group",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/VulnerabilityGroup"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by high-level vulnerability group",
              "title": "Vulnerability Group"
            },
            "description": "Filter by high-level vulnerability group"
          },
          {
            "name": "attention_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/AttentionStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by institutional attention status",
              "title": "Attention Status"
            },
            "description": "Filter by institutional attention status"
          },
          {
            "name": "min_urgency",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 5,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum urgency level (1-5)",
              "title": "Min Urgency"
            },
            "description": "Minimum urgency level (1-5)"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive name search",
              "title": "Search"
            },
            "description": "Case-insensitive name search"
          },
          {
            "name": "latitude",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 90.0,
                  "minimum": -90.0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Center latitude for spatial filter",
              "title": "Latitude"
            },
            "description": "Center latitude for spatial filter"
          },
          {
            "name": "longitude",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 180.0,
                  "minimum": -180.0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Center longitude for spatial filter",
              "title": "Longitude"
            },
            "description": "Center longitude for spatial filter"
          },
          {
            "name": "radius_meters",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 50000,
                  "minimum": 50
                },
                {
                  "type": "null"
                }
              ],
              "description": "Radius in meters for PostGIS ST_DWithin",
              "title": "Radius Meters"
            },
            "description": "Radius in meters for PostGIS ST_DWithin"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2000,
              "minimum": 1,
              "description": "Maximum number of places to return",
              "default": 500,
              "title": "Limit"
            },
            "description": "Maximum number of places to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlaceRead"
                  },
                  "title": "Response Listprioritizedplaces"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/places/heatmap": {
      "get": {
        "tags": [
          "places"
        ],
        "summary": "Get normalized heatmap coordinates and operational KPIs",
        "description": "Return weighted heatmap points, compact [lat, lon, intensity] matrix, and KPIs.",
        "operationId": "getHeatmapData",
        "parameters": [
          {
            "name": "zone_name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by zone name",
              "title": "Zone Name"
            },
            "description": "Filter by zone name"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/PlaceCategory"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by OSM place category",
              "title": "Category"
            },
            "description": "Filter by OSM place category"
          },
          {
            "name": "vulnerability_group",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/VulnerabilityGroup"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by vulnerability group",
              "title": "Vulnerability Group"
            },
            "description": "Filter by vulnerability group"
          },
          {
            "name": "include_attended",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Whether to include attended places in heatmap points",
              "default": true,
              "title": "Include Attended"
            },
            "description": "Whether to include attended places in heatmap points"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeatmapResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/places/{place_id}": {
      "get": {
        "tags": [
          "places"
        ],
        "summary": "Get a single vulnerable place by UUID",
        "description": "Retrieve details and 500m neighbor count for a single vulnerable place.",
        "operationId": "getPlaceById",
        "parameters": [
          {
            "name": "place_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Place Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "places"
        ],
        "summary": "Update institutional triage fields and recalculate priority score",
        "description": "Update attention status, urgency level, vulnerable population count, or notes.",
        "operationId": "updatePlaceTriage",
        "parameters": [
          {
            "name": "place_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Place Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceTriageUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttentionStatus": {
        "type": "string",
        "enum": [
          "pending",
          "in_progress",
          "attended"
        ],
        "title": "AttentionStatus",
        "description": "Operational dispatch status managed by response institutions."
      },
      "DashboardKPIsRead": {
        "properties": {
          "total_places": {
            "type": "integer",
            "title": "Total Places"
          },
          "pending_count": {
            "type": "integer",
            "title": "Pending Count"
          },
          "in_progress_count": {
            "type": "integer",
            "title": "In Progress Count"
          },
          "attended_count": {
            "type": "integer",
            "title": "Attended Count"
          },
          "critical_urgency_count": {
            "type": "integer",
            "title": "Critical Urgency Count"
          },
          "total_estimated_vulnerable": {
            "type": "integer",
            "title": "Total Estimated Vulnerable"
          },
          "max_priority_score": {
            "type": "number",
            "title": "Max Priority Score"
          },
          "counts_by_group": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Counts By Group"
          },
          "counts_by_category": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Counts By Category"
          }
        },
        "type": "object",
        "required": [
          "total_places",
          "pending_count",
          "in_progress_count",
          "attended_count",
          "critical_urgency_count",
          "total_estimated_vulnerable",
          "max_priority_score",
          "counts_by_group",
          "counts_by_category"
        ],
        "title": "DashboardKPIsRead",
        "description": "Aggregated operational KPIs for the dashboard header and analytics."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Operational status of the API service.",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Human-readable application service name.",
            "default": "Geo-Prioridad Vulnerable API"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Semantic version of the backend API.",
            "default": "0.1.0"
          }
        },
        "type": "object",
        "title": "HealthResponse",
        "description": "Typed response contract for service health status."
      },
      "HeatmapPointRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "$ref": "#/components/schemas/PlaceCategory"
          },
          "vulnerability_group": {
            "$ref": "#/components/schemas/VulnerabilityGroup"
          },
          "attention_status": {
            "$ref": "#/components/schemas/AttentionStatus"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "priority_score": {
            "type": "number",
            "title": "Priority Score"
          },
          "intensity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Intensity",
            "description": "Normalized heatmap intensity between 0.0 and 1.0."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "vulnerability_group",
          "attention_status",
          "latitude",
          "longitude",
          "priority_score",
          "intensity"
        ],
        "title": "HeatmapPointRead",
        "description": "Weighted geospatial point for heatmap visualization."
      },
      "HeatmapResponse": {
        "properties": {
          "points": {
            "items": {
              "$ref": "#/components/schemas/HeatmapPointRead"
            },
            "type": "array",
            "title": "Points"
          },
          "matrix": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 3,
              "minItems": 3
            },
            "type": "array",
            "title": "Matrix",
            "description": "Compact [latitude, longitude, normalized_intensity] tuples for Leaflet.heat."
          },
          "kpis": {
            "$ref": "#/components/schemas/DashboardKPIsRead"
          }
        },
        "type": "object",
        "required": [
          "points",
          "matrix",
          "kpis"
        ],
        "title": "HeatmapResponse",
        "description": "Combined heatmap points, compact [lat, lon, intensity] matrix, and KPIs."
      },
      "PlaceCategory": {
        "type": "string",
        "enum": [
          "hospital",
          "clinic",
          "social_facility",
          "kindergarten",
          "school",
          "community_centre",
          "university",
          "pharmacy",
          "commercial_hub",
          "place_of_worship"
        ],
        "title": "PlaceCategory",
        "description": "Supported vulnerable place categories derived from OpenStreetMap taxonomy."
      },
      "PlaceRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "osm_type": {
            "type": "string",
            "title": "Osm Type"
          },
          "osm_id": {
            "type": "integer",
            "title": "Osm Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "$ref": "#/components/schemas/PlaceCategory"
          },
          "vulnerability_group": {
            "$ref": "#/components/schemas/VulnerabilityGroup"
          },
          "zone_name": {
            "type": "string",
            "title": "Zone Name"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "osm_tags": {
            "additionalProperties": true,
            "type": "object",
            "title": "Osm Tags"
          },
          "attention_status": {
            "$ref": "#/components/schemas/AttentionStatus"
          },
          "urgency_level": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Urgency Level"
          },
          "estimated_vulnerable_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Estimated Vulnerable Count"
          },
          "institution_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution Notes"
          },
          "category_weight": {
            "type": "integer",
            "title": "Category Weight"
          },
          "nearby_places_count": {
            "type": "integer",
            "title": "Nearby Places Count",
            "description": "Count of other vulnerable places within 500m via PostGIS ST_DWithin.",
            "default": 0
          },
          "priority_score": {
            "type": "number",
            "title": "Priority Score"
          },
          "last_osm_sync_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Osm Sync At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "osm_type",
          "osm_id",
          "name",
          "category",
          "vulnerability_group",
          "zone_name",
          "latitude",
          "longitude",
          "osm_tags",
          "attention_status",
          "urgency_level",
          "estimated_vulnerable_count",
          "category_weight",
          "priority_score",
          "last_osm_sync_at",
          "updated_at"
        ],
        "title": "PlaceRead",
        "description": "Complete representation of a prioritized vulnerable place."
      },
      "PlaceTriageUpdate": {
        "properties": {
          "attention_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AttentionStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "Updated operational dispatch status."
          },
          "urgency_level": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Urgency Level",
            "description": "Institutional urgency rating from 1 (low) to 5 (critical)."
          },
          "estimated_vulnerable_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Vulnerable Count",
            "description": "Estimated number of vulnerable individuals at this location."
          },
          "institution_notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution Notes",
            "description": "Field notes entered by response coordinators."
          }
        },
        "type": "object",
        "title": "PlaceTriageUpdate",
        "description": "Patch payload for institutional triage updates."
      },
      "PredefinedZoneRead": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key",
            "description": "Unique identifier key of the predefined zone."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Display name of the municipality or zone."
          },
          "department": {
            "type": "string",
            "title": "Department",
            "description": "Department in El Salvador."
          },
          "latitude": {
            "type": "number",
            "title": "Latitude",
            "description": "Center latitude (WGS84)."
          },
          "longitude": {
            "type": "number",
            "title": "Longitude",
            "description": "Center longitude (WGS84)."
          },
          "default_radius_meters": {
            "type": "integer",
            "title": "Default Radius Meters",
            "description": "Recommended search radius in meters."
          }
        },
        "type": "object",
        "required": [
          "key",
          "name",
          "department",
          "latitude",
          "longitude",
          "default_radius_meters"
        ],
        "title": "PredefinedZoneRead",
        "description": "Schema representing a predefined geographic zone in El Salvador."
      },
      "SyncPlacesResponse": {
        "properties": {
          "zone_name": {
            "type": "string",
            "title": "Zone Name",
            "description": "Target zone name persisted in PostGIS."
          },
          "latitude": {
            "type": "number",
            "title": "Latitude",
            "description": "Queried center latitude."
          },
          "longitude": {
            "type": "number",
            "title": "Longitude",
            "description": "Queried center longitude."
          },
          "radius_meters": {
            "type": "integer",
            "title": "Radius Meters",
            "description": "Queried radius in meters."
          },
          "fetched_elements_count": {
            "type": "integer",
            "title": "Fetched Elements Count",
            "description": "Raw elements returned by Overpass or fallback seed."
          },
          "synced_places_count": {
            "type": "integer",
            "title": "Synced Places Count",
            "description": "Number of vulnerable places upserted into PostGIS."
          },
          "used_fallback": {
            "type": "boolean",
            "title": "Used Fallback",
            "description": "True when offline/rate-limit fallback seed data was used."
          },
          "source_endpoint": {
            "type": "string",
            "title": "Source Endpoint",
